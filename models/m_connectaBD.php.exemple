function connectaBD(){
    $servidor = "deic-docencia.uab.cat";
    $port     = "5432";
    $DBnom    = "tdiw-e6";
    $usuari   = "tdiw-e6";
    $clau     = "LA_TEVA_CONTRASENYA";

    $connexio = pg_connect("host=$servidor port=$port dbname=$DBnom user=$usuari password=$clau")
                or die("Error connexio BD");
    return $connexio;
}
